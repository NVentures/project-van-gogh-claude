# Legacy vault pointer (pre-0.13 installs kept it at the plugin root; it now
# lives at ~/.config/van-gogh/vault-pointer and self-migrates — see
# app/user_state.py). Kept ignored so a stale local copy is never committed.
# All other Van Gogh state lives in ~/.config/van-gogh/ and {vault}/van-gogh/.
.van-gogh-vault

# Stale repo-root user state (pre-vault-migration leftovers / local test output).
# The live config and logs live in {vault}/van-gogh/; these contain personal data
# and must never be committed to this client-facing template repo.
config.json
tasks.md
tasks_plan.md
logs/
.vscode/

.env
.claude/settings.json
.claude/settings.local.json
__pycache__/
*.pyc
.DS_Store
.venv/


# Meeting notetaker — set ONE of these (see config.json notetaker.provider).
GRANOLA_API_KEY=
GRAIN_API_KEY=

# Travel notices: your home address, used as the drive origin on a departure
# morning. It lives here rather than in config.json because config.json is
# synced into your vault and published to a web page; this file is not.
# Leave blank to get flight links and destination weather without drive time.
VAN_GOGH_HOME_ADDRESS=

# Google Maps Routes API key, for live drive time. Supplied with your install.
GOOGLE_MAPS_API_KEY=
